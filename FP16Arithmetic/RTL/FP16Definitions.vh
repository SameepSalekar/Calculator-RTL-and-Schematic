`ifndef FP16_DEFINITIONS_VH
`define FP16_DEFINITIONS_VH

`define FP16_WIDTH 16
`define FP16_SIGN_WIDTH 1
`define FP16_EXPONENT_WIDTH 5
`define FP16_FRACTION_WIDTH 10

`define FP16_SIGNIFICAND_WIDTH 11
`define FP16_SIGN_BIT 15
`define FP16_EXPONENT_MSB 14
`define FP16_EXPONENT_LSB 10
`define FP16_FRACTION_MSB 9
`define FP16_FRACTION_LSB 0

`define FP16_EXPONENT_RANGE 14:10
`define FP16_FRACTION_RANGE 9:0
`define FP16_EXPONENT_BIAS 15

`define FP16_EXPONENT_ZERO 5'b00000
`define FP16_EXPONENT_SPECIAL 5'b11111

`define FP16_EXPONENT_MIN_NORMAL 5'b00001
`define FP16_EXPONENT_MAX_NORMAL 5'b11110

`define FP16_FRACTION_ZERO 10'b0000000000
`define FP16_FRACTION_ALL_ONES 10'b1111111111

`define FP16_QUIET_NAN_BIT 9

`define FP16_SIGN_POSITIVE 1'b0
`define FP16_SIGN_NEGATIVE 1'b1

`define FP16_POSITIVE_ZERO 16'h0000
`define FP16_NEGATIVE_ZERO 16'h8000

`define FP16_POSITIVE_ONE 16'h3C00
`define FP16_NEGATIVE_ONE 16'hBC00

`define FP16_POSITIVE_HALF 16'h3800
`define FP16_NEGATIVE_HALF 16'hB800

`define FP16_POSITIVE_TWO 16'h4000
`define FP16_NEGATIVE_TWO 16'hC000

`define FP16_MIN_SUBNORMAL 16'h0001
`define FP16_MAX_SUBNORMAL 16'h03FF

`define FP16_MIN_NORMAL 16'h0400

`define FP16_MAX_FINITE 16'h7BFF 

`define FP16_MIN_FINITE 16'hFBFF

`define FP16_POSITIVE_INFINITY 16'h7C00
`define FP16_NEGATIVE_INFINITY 16'hFC00

`define FP16_CANONICAL_QNAN 16'h7E00
`define FP16_CANONICAL_SNAN 16'h7D00

`define FP16_CLASS_WIDTH 3
`define FP16_CLASS_ZERO 3'b000
`define FP16_CLASS_SUBNORMAL 3'b001
`define FP16_CLASS_NORMAL 3'b010
`define FP16_CLASS_INFINITY 3'b011
`define FP16_CLASS_QUIET_NAN 3'b100
`define FP16_CLASS_SIGNALING_NAN 3'b101

`define FP16_OPERATION_WIDTH 4
`define FP16_OP_ADD 4'b0000
`define FP16_OP_SUBTRACT 4'b0001
`define FP16_OP_COMPARE 4'b0010
`define FP16_OP_MULTIPLY 4'b0011
`define FP16_OP_SEQUENTIAL_MULTIPLY 4'b0100
`define FP16_OP_ACCUMULATE 4'b0101
`define FP16_OP_WIDE_ACCUMULATE 4'b0110
`define FP16_OP_MAC 4'b0111
`define FP16_OP_DIVIDE 4'b1000
`define FP16_OP_SQUARE_ROOT 4'b1001

`define FP16_ROUNDING_MODE_WIDTH 2

`define FP16_ROUND_NEAREST_EVEN 2'b00

`define FP16_ROUND_TOWARD_ZERO 2'b01
`define FP16_ROUND_TOWARD_POS_INF 2'b10
`define FP16_ROUND_TOWARD_NEG_INF 2'b11

`define FP16_EXCEPTION_WIDTH 5
`define FP16_EXCEPTION_INVALID_BIT 4
`define FP16_EXCEPTION_DIVZERO_BIT 3
`define FP16_EXCEPTION_OVERFLOW_BIT 2
`define FP16_EXCEPTION_UNDERFLOW_BIT 1
`define FP16_EXCEPTION_INEXACT_BIT 0

`define FP16_NO_EXCEPTIONS 5'b00000

`define FP16_GRS_WIDTH 3
`define FP16_EXTENDED_SIGNIFICAND_WIDTH 14
`define FP16_GUARD_BIT 2
`define FP16_ROCKY_BIT 1
`define FP16_STICKY_BIT 0

`endif
